{% extends 'admin.html.twig' %}

{% block title %}Inscription{% endblock %}
{%block aa%}
{% endblock %}
{%block bb%}
{% endblock %}
{%block cc%}
{% endblock %}
{% block body %}
    <h1>Inscription</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form.firstName, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}
    {{ form_row(form.lastName, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}
    {{ form_row(form.email, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}
    {{ form_row(form.password, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}
    {{ form_row(form.phoneNumber, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}
    {{ form_row(form.image, {'row_attr': {'style': 'margin-bottom: 20px;'}}) }}

    <button type="submit" class="btn btn-primary">S'inscrire</button>
{{ form_end(form) }}
{% endblock %}
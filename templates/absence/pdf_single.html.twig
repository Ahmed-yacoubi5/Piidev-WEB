<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Détails de l'absence #{{ absence.id }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #3f51b5;
            padding-bottom: 10px;
        }
        .header h1 {
            color: #3f51b5;
            margin-bottom: 5px;
        }
        .header p {
            color: #777;
            font-size: 14px;
        }
        .absence-details {
            margin-bottom: 30px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: #f5f5f5;
            font-weight: bold;
        }
        .section-title {
            color: #3f51b5;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
            margin-top: 25px;
            margin-bottom: 15px;
        }
        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: bold;
        }
        .status-approved {
            background-color: #dff0d8;
            color: #3c763d;
        }
        .status-pending {
            background-color: #fcf8e3;
            color: #8a6d3b;
        }
        .status-rejected {
            background-color: #f2dede;
            color: #a94442;
        }
        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 12px;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Détails de l'absence</h1>
        <p>ID: {{ absence.id }} | Généré le {{ "now"|date("d/m/Y à H:i") }}</p>
    </div>

    <h2 class="section-title">Informations d'absence</h2>
    <div class="absence-details">
        <table>
            <tr>
                <th>ID</th>
                <td>{{ absence.id }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ absence.type }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ absence.datedebut ? absence.datedebut|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ absence.datefin ? absence.datefin|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Employé ID</th>
                <td>{{ absence.employeeId }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>
                    <span class="status 
                        {% if absence.statut == 'Approved' %}status-approved
                        {% elseif absence.statut == 'Pending' %}status-pending
                        {% elseif absence.statut == 'Rejected' %}status-rejected{% endif %}">
                        {{ absence.statut }}
                    </span>
                </td>
            </tr>
        </table>
    </div>

    <h2 class="section-title">Informations complémentaires</h2>
    <p>Absence enregistrée dans le système.</p>

    <div class="footer">
        <p>Ce document est généré automatiquement par le système de gestion des absences.</p>
        <p>© {{ "now"|date("Y") }} Bahaa Corp - Tous droits réservés</p>
    </div>
</body>
</html> 
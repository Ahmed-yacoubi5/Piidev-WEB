{% extends 'base.html.twig' %}

{% block title %}Absence Management{% endblock %}

{% block body %}
    <section class="section-box-2">
        <div class="box-head-single none-bg">
            <div class="container">
                <h4>Absence Management</h4>
                <div class="row mt-15 mb-40">
                    <div class="col-lg-7 col-md-9">
                        <span class="text-mutted">Manage employee absences and time-off requests</span>
                    </div>
                    <div class="col-lg-5 col-md-3 text-lg-end text-start">
                        <ul class="breadcrumbs mt-sm-15">
                            <li><a href="#">Home</a></li>
                            <li>Absence Management</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-box mt-80">
        <div class="container">
            <div class="row flex-row-reverse">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12 float-right">
                    <div class="content-page">
                        <div class="box-shadow-bdrd-15 box-filters mb-30 p-3">
                            <form method="get" action="{{ path('app_absence_front_index') }}" class="row align-items-end gy-3">
                                <!-- Champ de recherche -->
                                <div class="col-lg-5 col-md-6">
                                    <label for="query" class="form-label fw-bold">Search</label>
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        id="query" 
                                        name="query" 
                                        placeholder="Employee name, type, or status..." 
                                        value="{{ app.request.get('query') }}"
                                    >
                                </div>

                                <!-- Tri -->
                                <div class="col-lg-3 col-md-6">
                                    <label for="sort" class="form-label fw-bold">Sort by</label>
                                    <select name="sort" id="sort" class="form-select">
                                        <option value="">-- Select --</option>
                                        <option value="datedebut" {% if app.request.get('sort') == 'datedebut' %}selected{% endif %}>Start Date</option>
                                        <option value="datefin" {% if app.request.get('sort') == 'datefin' %}selected{% endif %}>End Date</option>
                                        <option value="statut" {% if app.request.get('sort') == 'statut' %}selected{% endif %}>Status</option>
                                    </select>
                                </div>

                                <!-- Ordre -->
                                <div class="col-lg-2 col-md-6">
                                    <label for="order" class="form-label fw-bold">Order</label>
                                    <select name="order" id="order" class="form-select">
                                        <option value="asc" {% if app.request.get('order') == 'asc' %}selected{% endif %}>Ascending</option>
                                        <option value="desc" {% if app.request.get('order') == 'desc' %}selected{% endif %}>Descending</option>
                                    </select>
                                </div>

                                <!-- Bouton de recherche -->
                                <div class="col-lg-2 col-md-6 text-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="employers-list">
                            <div class="card-employers hover-up wow animate__animated animate__fadeIn">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Type</th>
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                <th>Employee</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for absence in pagination %}
                                            <tr>
                                                <td>{{ absence.id }}</td>
                                                <td>{{ absence.type }}</td>
                                                <td>{{ absence.datedebut ? absence.datedebut|date('Y-m-d H:i:s') : '' }}</td>
                                                <td>{{ absence.datefin ? absence.datefin|date('Y-m-d H:i:s') : '' }}</td>
                                                <td>{{ absence.employeeId }}</td>
                                                <td>
                                                    <span class="badge 
                                                        {% if absence.statut == 'Approved' %}bg-success
                                                        {% elseif absence.statut == 'Pending' %}bg-warning
                                                        {% elseif absence.statut == 'Rejected' %}bg-danger
                                                        {% else %}bg-secondary
                                                        {% endif %}">
                                                        {{ absence.statut }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="{{ path('app_absence_front_show', {'id': absence.id}) }}" class="btn btn-border btn-brand-hover">View</a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7" class="text-center">No records found</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                    
                                    {# Pagination améliorée et centrée #}
                                    <div class="d-flex justify-content-center mt-4">
                                        <div class="d-flex flex-column flex-md-row align-items-center">
                                            <div class="text-muted mb-2 mb-md-0 me-md-3">
                                                Showing {{ pagination.getCurrentPageNumber * pagination.getItemNumberPerPage - pagination.getItemNumberPerPage + 1 }} 
                                                to {{ min(pagination.getCurrentPageNumber * pagination.getItemNumberPerPage, pagination.getTotalItemCount) }} 
                                                of {{ pagination.getTotalItemCount }} entries
                                            </div>
                                            <nav aria-label="Page navigation">
                                                <ul class="pagination pagination-sm mb-0">
                                                    {# Premier bouton #}
                                                    <li class="page-item {% if pagination.currentPageNumber == 1 %}disabled{% endif %}">
                                                        <a class="page-link" href="{{ path('app_absence_front_index', app.request.query.all|merge({'page': 1})) }}" aria-label="First">
                                                            <span aria-hidden="true">&laquo;&laquo;</span>
                                                        </a>
                                                    </li>
                                                    
                                                    {# Bouton précédent #}
                                                    <li class="page-item {% if pagination.currentPageNumber == 1 %}disabled{% endif %}">
                                                        <a class="page-link" href="{{ path('app_absence_front_index', app.request.query.all|merge({'page': pagination.currentPageNumber - 1})) }}" aria-label="Previous">
                                                            <span aria-hidden="true">&laquo;</span>
                                                        </a>
                                                    </li>
                                                    
                                                    {# Boutons de pages #}
                                                    {% set nearbyPagesLimit = 2 %}
                                                    {% for i in 1..pagination.pageCount %}
                                                        {% if 0 == (pagination.currentPageNumber - nearbyPagesLimit) - loop.index %}
                                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                                        {% elseif 0 == (pagination.currentPageNumber + nearbyPagesLimit) - loop.index %}
                                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                                        {% elseif 0 < (pagination.currentPageNumber - nearbyPagesLimit) - loop.index %}
                                                        {% elseif 0 > (pagination.currentPageNumber + nearbyPagesLimit) - loop.index %}
                                                        {% else %}
                                                            <li class="page-item {% if pagination.currentPageNumber == loop.index %}active{% endif %}">
                                                                <a class="page-link" href="{{ path('app_absence_front_index', app.request.query.all|merge({'page': loop.index})) }}">{{ loop.index }}</a>
                                                            </li>
                                                        {% endif %}
                                                    {% endfor %}
                                                    
                                                    {# Bouton suivant #}
                                                    <li class="page-item {% if pagination.currentPageNumber == pagination.pageCount %}disabled{% endif %}">
                                                        <a class="page-link" href="{{ path('app_absence_front_index', app.request.query.all|merge({'page': pagination.currentPageNumber + 1})) }}" aria-label="Next">
                                                            <span aria-hidden="true">&raquo;</span>
                                                        </a>
                                                    </li>
                                                    
                                                    {# Dernier bouton #}
                                                    <li class="page-item {% if pagination.currentPageNumber == pagination.pageCount %}disabled{% endif %}">
                                                        <a class="page-link" href="{{ path('app_absence_front_index', app.request.query.all|merge({'page': pagination.pageCount})) }}" aria-label="Last">
                                                            <span aria-hidden="true">&raquo;&raquo;</span>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </nav>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
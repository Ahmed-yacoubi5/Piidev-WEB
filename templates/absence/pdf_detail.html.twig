{% extends 'absence/pdf_template.html.twig' %}

{% block title %}Détails d'Absence - {{ absence.id }}{% endblock %}

{% block header_title %}Détails de la Demande d'Absence{% endblock %}

{% block header_additional %}Document généré le {{ "now"|date("d/m/Y à H:i") }}{% endblock %}

{% block content %}
    <h2>Informations sur l'Absence</h2>
    <table>
        <tr>
            <th style="width: 30%;">ID</th>
            <td>{{ absence.id }}</td>
        </tr>
        <tr>
            <th>Type d'Absence</th>
            <td>{{ absence.type }}</td>
        </tr>
        <tr>
            <th>Date de Début</th>
            <td>{{ absence.datedebut|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <th>Date de Fin</th>
            <td>{{ absence.datefin|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <th>Statut</th>
            <td>
                <span class="status {% if absence.statut == 'Approved' %}status-approved
                    {% elseif absence.statut == 'Pending' %}status-pending
                    {% elseif absence.statut == 'Rejected' %}status-rejected{% endif %}">
                    {{ absence.statut }}
                </span>
            </td>
        </tr>
        <tr>
            <th>Durée</th>
            <td>
                {% set diff = date(absence.datefin).diff(date(absence.datedebut)) %}
                {{ diff.days + 1 }} jour(s)
            </td>
        </tr>
    </table>

    <div style="margin-top: 30px;">
        <h2>Informations sur l'Employé</h2>
        <table>
            <tr>
                <th style="width: 30%;">ID Employé</th>
                <td>{{ absence.employeeId }}</td>
            </tr>
        </table>
    </div>

    {% if stats is defined %}
    <div style="margin-top: 30px;">
        <h2>Statistiques de l'Employé</h2>
        <div style="display: flex; justify-content: space-between; margin-top: 15px;">
            <div style="width: 32%; background: #d1e7dd; padding: 15px; border-radius: 5px; text-align: center;">
                <h3 style="margin: 0 0 10px 0; color: #0f5132;">Approuvées</h3>
                <p style="font-size: 24px; font-weight: bold; margin: 0;">{{ stats.approved }}</p>
            </div>
            <div style="width: 32%; background: #fff3cd; padding: 15px; border-radius: 5px; text-align: center;">
                <h3 style="margin: 0 0 10px 0; color: #664d03;">En attente</h3>
                <p style="font-size: 24px; font-weight: bold; margin: 0;">{{ stats.pending }}</p>
            </div>
            <div style="width: 32%; background: #f8d7da; padding: 15px; border-radius: 5px; text-align: center;">
                <h3 style="margin: 0 0 10px 0; color: #842029;">Rejetées</h3>
                <p style="font-size: 24px; font-weight: bold; margin: 0;">{{ stats.rejected }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <div style="margin-top: 50px;">
        <h2>Validation</h2>
        <table>
            <tr>
                <th style="width: 30%;">Demandé par</th>
                <td style="height: 60px; vertical-align: top;">
                    Employé #{{ absence.employeeId }}
                    <div style="margin-top: 40px;">Signature: _______________________</div>
                </td>
            </tr>
            <tr>
                <th>Approuvé par</th>
                <td style="height: 60px; vertical-align: top;">
                    {% if absence.statut == 'Approved' %}
                    Responsable RH
                    {% else %}
                    _______________________
                    {% endif %}
                    <div style="margin-top: 40px;">Signature: _______________________</div>
                </td>
            </tr>
        </table>
    </div>
{% endblock %}

{% block footer_additional %}
    <p>Référence: ABS-{{ absence.id }}-{{ "now"|date("Ymd") }}</p>
{% endblock %} 
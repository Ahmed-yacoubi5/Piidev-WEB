{% extends 'base.html.twig' %}

{% block title %}Create New Event{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Create New Event</h5>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title, { 'attr': {'class': 'form-control'} }) }}
                    {{ form_errors(form.title) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, { 'attr': {'class': 'form-control'} }) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.startDate) }}
                        {{ form_widget(form.startDate, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(form.startDate) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.endDate) }}
                        {{ form_widget(form.endDate, { 'attr': {'class': 'form-control'} }) }}
                        {{ form_errors(form.endDate) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.location) }}
                    {{ form_widget(form.location, { 'attr': {'class': 'form-control'} }) }}
                    {{ form_errors(form.location) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.capacity) }}
                    {{ form_widget(form.capacity, { 'attr': {'class': 'form-control'} }) }}
                    {{ form_errors(form.capacity) }}
                </div>
                <div class="form-check mb-3">
                    {{ form_widget(form.isPublic) }}
                    {{ form_label(form.isPublic) }}
                    {{ form_errors(form.isPublic) }}
                </div>
                <button type="submit" class="btn btn-primary">Create Event</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
